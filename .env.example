# ===== LLM 厂商 =====
# 厂商清单外置在 config/llm_providers.json —— 可在「系统配置 → 模型接入」页面上
# 增删改，也可以直接编辑该文件（不创建它时使用内置的 DeepSeek + Qwen，
# 路由行为与改造前完全一致）。
#
# 任何 **OpenAI 兼容端点** 都能接入。接入方式：在清单里加一条记录，
# 指定 base_url + api_key_env（指向下面这些变量名之一），例如：
#
#   kimi    (月之暗面)  base_url: https://api.moonshot.cn/v1             MOONSHOT_API_KEY
#   glm     (智谱)      base_url: https://open.bigmodel.cn/api/paas/v4    ZHIPU_API_KEY
#   doubao  (火山方舟)  base_url: https://ark.cn-beijing.volces.com/api/v3  ARK_API_KEY
#   openai              base_url: https://api.openai.com/v1               OPENAI_API_KEY
#   ollama  (本地)      base_url: http://localhost:11434/v1               （key 随便填）
#
# 默认模型：深度分析 / AI 助手在未显式指定模型时使用（空则跟随 DEEPSEEK_MODEL）
DEFAULT_MODEL_NAME=deepseek-chat

# ===== 功能级模型分配（可选，独立于本文件）=====
# 「哪个功能用哪个模型」外置在 config/llm_feature_models.json，界面在
# 「系统配置 → 🎚️ 功能模型分配」。**改完即时生效，无需重启进程**（按文件 mtime 热加载）。
# 未指定的功能「跟随默认」：多数走上面的 DEFAULT_MODEL_NAME；AI 助手/每日复盘/市场观点
# 走各自的默认档位（QWEN_TURBO_MODEL / QWEN_PLUS_MODEL），以求与改造前行为一致。
# 功能键清单与默认档位见 config/model_routing.py::FEATURES。
# 例：{"version": 1, "models": {"agents.bull": "qwen-max", "chat.tool_loop": "qwen-turbo"}}


# DeepSeek 配置（内置厂商之一，可继续沿用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen 配置（内置厂商之一，走 DashScope 兼容模式；模型名以 qwen- 开头时路由到这里）
# ⚠️ 2026-10-13 实测：部分账号下 qwen-plus 报 403「Free quota exhausted」、
#    qwen-turbo 报 404「Model not exist」。变量名 PLUS/TURBO 指"模型档位"而非具体型号，
#    请按自己账号实际可用的型号填写（本项目当前两个档位都用 qwen-max）。
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PLUS_MODEL=qwen-max
QWEN_TURBO_MODEL=qwen-max

# ===== 可选的第三家（在清单里加记录后，把密钥填在这里）=====
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# OPENAI_API_KEY=
# ARK_API_KEY=

# Tushare Token（可选备用数据源，启用个股资金流 moneyflow 降级链）
TUSHARE_TOKEN=

# 钉钉通知 Webhook（可选）
DINGTALK_WEBHOOK=

# 飞书通知 Webhook（可选）
FEISHU_WEBHOOK=
