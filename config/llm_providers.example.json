{
  "_readme": [
    "多厂商 LLM 接入清单。复制为 config/llm_providers.json 后生效",
    "（也可以直接用「系统配置 → 模型接入」页面上的按钮生成/编辑）。",
    "",
    "字段说明：",
    "  id            必填。小写字母/数字/_/-，全局唯一。",
    "  name          显示名。",
    "  base_url      OpenAI 兼容端点。",
    "  base_url_env  可选。指向 .env 里的变量名，优先级高于 base_url。",
    "  api_key_env   推荐。指向 .env 里的变量名（清单里不存明文密钥）。",
    "  api_key       不推荐，明文会落在文件里，有被提交的风险。",
    "  models        已声明的模型名（UI 下拉用；精确匹配时也用它）。",
    "  match         通配模式，命中列表外的模型名，如 [\"kimi-*\"]。",
    "  enabled       置 false 后该厂商不参与路由。",
    "",
    "路由优先级：models 精确命中 → match 通配命中（按顺序）→ default_provider 兜底。",
    "本文件已被 .gitignore 忽略（可能含明文密钥）；结构变化请同步更新本 example。"
  ],
  "version": 1,
  "default_provider": "deepseek",
  "providers": [
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "base_url": "https://api.deepseek.com",
      "base_url_env": "DEEPSEEK_BASE_URL",
      "api_key_env": "DEEPSEEK_API_KEY",
      "models": ["deepseek-v4-flash", "deepseek-v4-pro", "deepseek-chat", "deepseek-reasoner"],
      "match": ["deepseek-*"],
      "enabled": true
    },
    {
      "id": "qwen",
      "name": "通义千问 (DashScope)",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "base_url_env": "QWEN_BASE_URL",
      "api_key_env": "QWEN_API_KEY",
      "models": ["qwen-plus", "qwen-turbo", "qwen-max"],
      "match": ["qwen-*"],
      "enabled": true
    },
    {
      "id": "kimi",
      "name": "月之暗面 Kimi（示例，未启用）",
      "base_url": "https://api.moonshot.cn/v1",
      "api_key_env": "MOONSHOT_API_KEY",
      "models": ["moonshot-v1-8k", "moonshot-v1-32k", "kimi-k2-0711-preview"],
      "match": ["moonshot-*", "kimi-*"],
      "enabled": false
    }
  ]
}
